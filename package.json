{
  "name": "aby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A learning tutor for the pi agent harness: assesses your level, builds a roadmap graph, generates lessons, and quizzes you on them.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@lancedb/lancedb": "0.37.1",
    "apache-arrow": "18.1.0",
    "grok-mermaid": "0.2.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "24.10.1",
    "typebox": "1.3.14",
    "typescript": "5.9.3"
  }
}
